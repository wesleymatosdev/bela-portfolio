{
  "name": "@sveltia/cms",
  "version": "0.250.1",
  "description": "Sveltia CMS is a modern, lightweight, Git-based headless content management system.",
  "keywords": [
    "svelte",
    "cms",
    "content-management-system"
  ],
  "homepage": "https://sveltiacms.app/en/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sveltia/sveltia-cms.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/kyoshino"
  },
  "license": "MIT",
  "author": {
    "name": "Kohei Yoshino",
    "url": "https://github.com/kyoshino"
  },
  "type": "module",
  "peerDependencies": {
    "@types/react": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "dependencies": {
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "exifr": "^7.1.3",
    "immutable": "^5.1.9",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^6.4.299",
    "svgo": "^4.1.0",
    "terra-draw": "^1.38.0",
    "terra-draw-leaflet-adapter": "1.0.3",
    "turndown": "^7.2.4"
  },
  "files": [
    "dist",
    "npm",
    "locales",
    "schema",
    "services",
    "types",
    "main.d.ts"
  ],
  "main": "./npm/index.js",
  "module": "./npm/index.js",
  "exports": {
    ".": {
      "types": "./main.d.ts",
      "default": "./npm/index.js"
    }
  },
  "typesVersions": {
    ">4.0": {
      "index": [
        "./main.d.ts"
      ]
    }
  }
}