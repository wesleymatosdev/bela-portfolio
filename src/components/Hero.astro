---
import Wordmark from './Wordmark.astro';
---
<section class="hero">
  <div class="keycap-group over">
    <div class="keycap">O</div><div class="keycap">V</div><div class="keycap">E</div><div class="keycap">R</div>
  </div>

  <div class="name-container">
    <h1 class="name"><Wordmark idPrefix="" cls="name-wordmark" /></h1>
    <p class="subtitle">Creative Designer · Social Media</p>
    <p class="tagline">Helping people &amp; brands communicate beautifully.</p>
  </div>

  <div class="postit-wrap">
    <div class="postit" id="aboutPostit" role="button" tabindex="0" aria-expanded="false" aria-controls="aboutPanel">
      <div class="postit-head">
        <h2>ABOUT ME</h2>
        <span class="postit-hint">click to unfold</span>
      </div>
      <div class="postit-panel" id="aboutPanel">
        <div class="postit-panel-inner">
          <p>I'm Isabela — a creative designer based in Brazil, specializing in brand identity and social media content. I love mixing playful visuals with strategic thinking to help brands stand out. When I'm not designing, you'll find me sketching on grid paper and collecting cool keycaps.</p>
          <div class="postit-skills">
            <span class="skill-chip">Branding</span><span class="skill-chip">Social Media</span><span class="skill-chip">Illustration</span><span class="skill-chip">Packaging</span><span class="skill-chip">Editorial</span><span class="skill-chip">Figma</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="social-stickers">
    <a href="https://www.linkedin.com/in/isabela-rossi-883455340/" target="_blank" rel="noopener" class="social-sticker" aria-label="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>
    <a href="mailto:belarossi.art@gmail.com" class="social-sticker" aria-label="Email"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg></a>
  </div>

  <div class="keycap-group flow">
    <div class="keycap blue">F</div><div class="keycap blue">L</div><div class="keycap blue">O</div><div class="keycap blue">W</div>
  </div>

  <div class="scroll-hint">↓ scroll ↓</div>
</section>
